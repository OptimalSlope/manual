# Let Git decide for anything not listed below.
* text=auto

# --- Assistant knowledge base -------------------------------------------
# manual.txt is hashed by tools/build_kb.py and shipped to the model verbatim.
# A CRLF checkout changes its SHA-256, which breaks `build_kb.py --check` and
# busts the prompt cache, since the manual must be byte-identical on every
# request to hit the cached prefix. Pin these to LF everywhere.
kb/*.txt             text eol=lf
kb/*.json            text eol=lf

# --- Tooling ------------------------------------------------------------
*.py                 text eol=lf
*.yml                text eol=lf
*.yaml               text eol=lf
*.sh                 text eol=lf

# --- Binary assets ------------------------------------------------------
*.png                binary
*.bmp                binary
*.gif                binary
*.mp4                binary
*.glb                binary
*.ico                binary
*.woff               binary
*.woff2              binary
*.ttf                binary
*.otf                binary
